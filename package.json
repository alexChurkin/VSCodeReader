{
  "name": "vscode-reader",
  "displayName": "VSCodeReader",
  "description": "Read EPUB, FB2, TXT, CBZ, HTML and Markdown in a quiet terminal tab, with illustrations in editor tabs.",
  "version": "0.1.0",
  "publisher": "alexChurkin",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexChurkin/VSCodeReader.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:vscodeReader.openBook",
    "onCommand:vscodeReader.resume",
    "onView:vscodeReader.library"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vscodeReader.openBook",
        "title": "VSCodeReader: Open Book",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vscodeReader.resume",
        "title": "VSCodeReader: Resume Reading",
        "icon": "$(play)"
      },
      {
        "command": "vscodeReader.hide",
        "title": "VSCodeReader: Hide Text",
        "icon": "$(eye-closed)"
      },
      {
        "command": "vscodeReader.openImage",
        "title": "VSCodeReader: Open Image"
      },
      {
        "command": "vscodeReader.focusSession",
        "title": "VSCodeReader: Continue Selected Book",
        "icon": "$(book)"
      },
      {
        "command": "vscodeReader.openRecent",
        "title": "VSCodeReader: Open Recent Book",
        "icon": "$(history)"
      },
      {
        "command": "vscodeReader.nextPage",
        "title": "VSCodeReader: Next Screen",
        "icon": "$(arrow-down)"
      },
      {
        "command": "vscodeReader.previousPage",
        "title": "VSCodeReader: Previous Screen",
        "icon": "$(arrow-up)"
      },
      {
        "command": "vscodeReader.showProgress",
        "title": "VSCodeReader: Show Reading Progress",
        "icon": "$(info)"
      },
      {
        "command": "vscodeReader.goToLocation",
        "title": "VSCodeReader: Go to Page",
        "icon": "$(location)"
      },
      {
        "command": "vscodeReader.addBookmark",
        "title": "VSCodeReader: Add Bookmark",
        "icon": "$(bookmark)"
      },
      {
        "command": "vscodeReader.showBookmarks",
        "title": "VSCodeReader: Show Bookmarks",
        "icon": "$(bookmark)"
      },
      {
        "command": "vscodeReader.goToBookmark",
        "title": "VSCodeReader: Go to Bookmark",
        "icon": "$(bookmark)"
      },
      {
        "command": "vscodeReader.renameBookmark",
        "title": "VSCodeReader: Rename Bookmark",
        "icon": "$(edit)"
      },
      {
        "command": "vscodeReader.deleteBookmark",
        "title": "VSCodeReader: Delete Bookmark",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscodeReader.openBook",
          "when": "resourceFilename =~ /\\.(epub|fb2|fb2\\.zip|fbz|txt|cbz|html?|md|markdown)$/i",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "vscodeReader.openBook",
          "when": "view == vscodeReader.library",
          "group": "navigation@0"
        },
        {
          "command": "vscodeReader.resume",
          "when": "view == vscodeReader.library",
          "group": "navigation@1"
        },
        {
          "command": "vscodeReader.addBookmark",
          "when": "view == vscodeReader.library && vscodeReader.hasBook",
          "group": "navigation@2"
        },
        {
          "command": "vscodeReader.hide",
          "when": "view == vscodeReader.library && vscodeReader.hasBook",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "vscodeReader.renameBookmark",
          "when": "view == vscodeReader.library && viewItem == readerBookmark",
          "group": "inline@0"
        },
        {
          "command": "vscodeReader.deleteBookmark",
          "when": "view == vscodeReader.library && viewItem == readerBookmark",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "VSCodeReader",
      "properties": {
        "vscodeReader.terminalName": {
          "type": "string",
          "default": "{title}",
          "description": "Terminal tab name. Use {title} for the book title and {filename} for the file name. The old output default is replaced with the book title."
        },
        "vscodeReader.linePrefix": {
          "type": "string",
          "default": "",
          "maxLength": 12,
          "description": "Optional console-style prefix, for example [text] ."
        },
        "vscodeReader.textEncoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "windows-1251"
          ],
          "default": "utf-8",
          "description": "Encoding for TXT, HTML and Markdown documents without a BOM or HTML charset declaration. Applies to new reading sessions."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodeReader",
          "title": "Reader",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "vscodeReader": [
        {
          "id": "vscodeReader.library",
          "name": "Library",
          "visibility": "visible"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --out vscode-reader-0.1.0.vsix",
    "test:host": "npm run build && node scripts/test-host.mjs",
    "prepackage": "node scripts/clean-packages.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "domhandler": "6.0.1",
    "fast-xml-parser": "5.12.1",
    "htmlparser2": "12.0.0",
    "marked": "18.2.0",
    "string-width": "9.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
